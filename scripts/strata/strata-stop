#!/bin/sh
# strata-stop — гарантированное добивание дерева нативной Strata.
#
# Вызывается systemd-юнитом strata.service как ExecStop; также вызывается
# strata-use.sh как страховка, если юнит не установлен или движок висит
# вне юнита. Идемпотентен: если процессов нет — тихий успех (exit 0).
#
# Почему обязателен: однажды SIGTERM server.py был проглочен, а движок-
# ребёнок (/opt/strata/engine/strata) продолжал держать VRAM/RAM до
# прямого kill (тикет 01). Здесь: TERM всем → ждать → KILL → проверка.
#
# Коды выхода: 0 — дерева нет (или добито); 4 — не удалось добить.

set -u

RE='/opt/strata/(serve/server\.py|engine/strata)'

wait_gone() {
    # $1 = число проверок по 0.5 c
    i=0
    while [ "$i" -lt "$1" ]; do
        pgrep -f "$RE" >/dev/null 2>&1 || return 0
        sleep 0.5
        i=$((i + 1))
    done
    return 1
}

# TERM всему дереву (server.py с его детьми, движок и strata-vision)
pkill -TERM -f "$RE" 2>/dev/null
sleep 0.5

if ! wait_gone 20; then
    # KILL-эскалация (systemd при TimeoutStopSec сделает то же для cgroup)
    pkill -KILL -f "$RE" 2>/dev/null
    if ! wait_gone 10; then
        echo "strata-stop: дерево Strata не добито — проверьте pgrep -af '$RE'" >&2
        exit 4
    fi
fi

exit 0
