# strata.service — нативный движок Strata (Qwen3.8-Flash-Next) на хосте.
#
# Часть карты .scratch/strata-integration/ (тикет 02: нативный lifecycle).
# Источник правды — этот файл в репозитории; устанавливается симлинком:
#
#   sudo ln -s "<repo>/scripts/strata/strata.service" /etc/systemd/system/strata.service
#   sudo ln -s "<repo>/scripts/strata/strata-stop"    /usr/local/sbin/strata-stop
#   sudo mkdir -p /etc/strata && sudo systemctl daemon-reload
#
# Выбор размера (IQ3_XXS / IQ2_XS) — симлинком /etc/strata/active.json на
# один из /opt/strata/strata-iq3_xxs.json / strata-iq2_xs.json. Симлинк
# ставит ТОЛЬКО strata-use.sh (единственная точка правды переключения);
# вручную `systemctl start strata` без скрипта отказывается ExecStartPre'ом.
#
# Формат запуска движка проверен по run-iq3_xxs.sh / run-iq2_xs.sh:
# python serve/server.py --engine strata --config <json> --port 8081.
# Флаг --open из run-скриптов (браузер) в юните не нужен.
# ВАЖНО: --port 8081 обязателен в argv — HTTP-листенер берёт порт ТОЛЬКО
# из CLI (default 8095); host берётся из конфига (172.17.0.1, docker0).
#
# Логи: journald -u strata (stdout/stderr server.py) + файл-лог движка из
# конфига (/opt/strata/strata-iq3_xxs.log и т.п.). Метрики/ошибки смотрим
# в journald (llm-monitoring выведен из эксплуатации).
#
# АВТОСТАРТ ВЫКЛЮЧЕН (не enable): окно «вытесняющий режим» ручное — юнит
# не должен захватывать VRAM после ребута в обход родительского профиля
# llama-swap. Поднимается только strata-use.sh.
#
# Останов: ExecStop добивает ВСЁ дерево процессов (pkill server.py и
# engine/strata*): однажды SIGTERM server.py был проглочен, а движок-ребёнок
# продолжал держать VRAM/RAM до прямого kill (тикет 01). Подстраховка
# сверх ExecStop — KillMode=control-group и TimeoutStopSec=25 (SIGKILL
# от systemd), плюс strata-use.sh проверяет фактическое освобождение
# процессов/VRAM после останова.

[Unit]
Description=Strata native engine (Qwen3.8-Flash-Next, :8081, размер через /etc/strata/active.json)
After=network.target

[Service]
Type=simple
User=dimmy
Group=dimmy
WorkingDirectory=/opt/strata
ExecStartPre=/bin/sh -c 'test -f /etc/strata/active.json || (echo "нет /etc/strata/active.json — размер выбирает strata-use.sh, вручную юнит не запускать"; exit 1)'
ExecStart=/opt/strata/.venv/bin/python /opt/strata/serve/server.py --engine strata --config /etc/strata/active.json --port 8081
ExecStop=/usr/local/sbin/strata-stop
KillMode=control-group
TimeoutStopSec=25
Restart=no

[Install]
WantedBy=multi-user.target
