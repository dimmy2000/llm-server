// Потребительский конфиг opencode v2 для локального стека llm-server
// (llama-swap :8080, единый model-ID qwen3.8-27b, тикет 14 карты
// .scratch/llama-swap-orchestrator). Бэкап до правки: opencode.jsonc.bak-ticket14.
//
// opencode v2.0.32: reasoning управляется ВАРИАНТАМИ модели (providers.*.models.*.variants),
// а не оверлеями агента — agent.*.options/reasoningEffort/request.body в тело запроса
// не попадают (мёртвые настройки удалены). Вариант выбирается только на прогон:
//   opencode run -m 'llama-swap/qwen3.8-27b#off|low|medium|xhigh'
// Корневой "model" вариант "#..." игнорирует (проверено на v2.0.32), поэтому здесь
// он без варианта: голый ID = дефолт шаблона движка (thinking + xhigh).
// Тела вариантов — chat_template_kwargs: единственный переносимый контракт
// для llama.cpp и NInfer (см. docs/research/0014, тикет 11 карты):
// enable_thinking:false = instruct, reasoning_effort = low|medium|xhigh.
{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama-swap/qwen3.8-27b",
  "agent": {
    // план-агенту — локальная модель (бывший reasoningEffort: xhigh был мёртвым;
    // голый ID и так даёт thinking + xhigh)
    "plan": {
      "model": "llama-swap/qwen3.8-27b"
    }
  },
  "provider": {
    "self-hosted": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Self Hosted",
      "options": {
        "baseURL": "http://192.168.17.69:9000/v1"
      },
      "models": {
        "rus-gpt/anthropic/claude-fable-5.1": {
          "name": "Claude Fable 5.1 (rus-gpt)"
